# Cloudflare Pages response headers (backup deploy). Ignored by GitHub Pages.
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

# Backup mirror must not be indexed as a duplicate of scorekeeper.triviarevolution.com.
/*
  X-Robots-Tag: noindex

# Service worker + version/manifest files must always revalidate so updates land promptly.
/sw.js
  Cache-Control: no-cache
/version.json
  Cache-Control: no-cache
/manifest.json
  Cache-Control: no-cache

# Large static assets with stable (non-fingerprinted) names: cache for a day.
/fonts/*
  Cache-Control: public, max-age=86400
/faq/fonts/*
  Cache-Control: public, max-age=86400
/assets/audio/*
  Cache-Control: public, max-age=86400
/icons/*
  Cache-Control: public, max-age=86400
/faq/screenshots/*
  Cache-Control: public, max-age=86400
